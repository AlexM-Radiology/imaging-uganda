---
import TeamHeroImage from "../assets/lameck-5.jpg";
import Layout from "../layouts/ArticlesPost.astro";
import { Image } from "astro:assets";

import pishonImg from "../assets/pishon-1.jpg";
import lameckImg from "../assets/lameck-5.jpg";
import henryImg from "../assets/henry-1.jpg";
---

<Layout
  title="Our Team | Imaging Uganda/Africa"
  description="Meet the founders and collaborators behind Imaging Uganda/Africa, a community advancing medical imaging education across the region."
  pubDate={new Date("May 23 2026")}
  heroImage={TeamHeroImage}
>
  <section class="intro">
    <h2>Meet the people behind the platform</h2>
    <p>
      Imaging Uganda/Africa is built by medical imaging professionals who believe
      knowledge grows when it is shared. Our founders bring experience in
      radiography, ultrasound, teaching, public health, and medical imaging
      services.
    </p>
  </section>

  <section class="team-section" aria-labelledby="founders-heading">
    <h2 id="founders-heading">Our Founders</h2>
    <p class="section-intro">
      Learn more about each founder and explore their professional experience.
    </p>

    <div class="team-grid">
      <a
        href="/cvs/mwanje-pishon"
        class="team-card"
        title="View Mwanje Pishon's CV"
      >
        <Image src={pishonImg} alt="Mwanje Pishon" class="team-avatar" />
        <h3>Mwanje Pishon</h3>
        <p class="role">Medical Imaging Technologist &amp; Co-Founder</p>
        <p class="bio">
          A registered medical imaging technologist with experience in teaching
          and ultrasound, X-ray, CT, MRI, mammography, and fluoroscopy.
        </p>
        <span class="profile-link">View professional profile &rarr;</span>
      </a>

      <a href="/cvs/lameck" class="team-card" title="View Lameck's CV">
        <Image src={lameckImg} alt="Lameck" class="team-avatar" />
        <h3>Lameck</h3>
        <p class="role">Radiographer &amp; Co-Founder</p>
        <p class="bio">
          A diagnostic imaging professional with over 13 years of experience
          across imaging modalities and a background in public health.
        </p>
        <span class="profile-link">View professional profile &rarr;</span>
      </a>

      <a
        href="/cvs/ssenyonga-henry"
        class="team-card"
        title="View Ssenyonga Henry's CV"
      >
        <Image src={henryImg} alt="Ssenyonga Henry" class="team-avatar" />
        <h3>Ssenyonga Henry</h3>
        <p class="role">Medical Radiographer &amp; Co-Founder</p>
        <p class="bio">
          A registered medical radiographer working across ultrasound, X-ray,
          CT, MRI, mammography, and fluoroscopy, and founder of Rem Medical
          Solutions.
        </p>
        <span class="profile-link">View professional profile &rarr;</span>
      </a>
    </div>
  </section>

  <section class="collaboration">
    <h2>Growing through collaboration</h2>
    <p>
      Our platform is more than its founding team. Radiographers, medical
      imaging technologists, educators, students, and other healthcare
      professionals contribute knowledge, discuss cases, and learn from one
      another. This shared effort helps make practical imaging education more
      accessible across Uganda, East Africa, and beyond.
    </p>
    <p>
      Have expertise or educational content to share? We welcome contributions
      from the imaging community.<br /> <a href="mailto:alexmradiology@gmail.com">alexmradiology@gmail.com</a> <br /> <a href="tel:+256786467098">+256 786 467 098</a>
    </p>
  </section>
</Layout>

<style>
  .intro,
  .team-section,
  .collaboration {
    margin-bottom: 2.5rem;
  }

  .intro h2,
  .team-section h2,
  .collaboration h2 {
    color: rgb(0, 0, 139);
    font-size: 26px;
    margin-bottom: 0.75rem;
  }

  .section-intro {
    color: #666;
    margin-bottom: 1.5rem;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.5rem;
  }

  .team-card {
    align-items: center;
    background: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: 8px;
    color: inherit;
    display: flex;
    flex-direction: column;
    padding: 1.75rem 1.5rem;
    text-align: center;
    text-decoration: none;
    transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out,
      border-color 0.2s ease-in-out;
  }

  .team-card:hover,
  .team-card:focus-visible {
    border-color: rgb(0, 0, 139);
    box-shadow: 0 4px 12px rgba(0, 0, 139, 0.08);
    transform: translateY(-4px);
  }

  .team-avatar {
    border: 2px solid rgba(0, 0, 139, 0.1);
    border-radius: 50%;
    height: 90px;
    margin-bottom: 1rem;
    object-fit: cover;
    transition: border-color 0.2s ease;
    width: 90px;
  }

  .team-card:hover .team-avatar,
  .team-card:focus-visible .team-avatar {
    border-color: rgb(0, 0, 139);
  }

  .team-card h3 {
    color: #212529;
    font-size: 20px;
    margin: 0.25rem 0;
  }

  .role {
    color: rgb(0, 0, 139);
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 1rem;
  }

  .bio {
    color: #555;
    flex-grow: 1;
    font-size: 14px;
    line-height: 1.5;
    margin: 0 0 1.5rem;
  }

  .profile-link {
    color: rgb(0, 0, 139);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }

  .collaboration {
    border-top: 1px solid #e9ecef;
    padding-top: 2rem;
  }

  .collaboration a {
    color: rgb(0, 0, 139);
    font-weight: 600;
  }
</style>
