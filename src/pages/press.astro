---
import Layout from '../layouts/ArticlesPost.astro';
---

<Layout
  title="Press and Media"
  description="Contact Imaging Uganda/Africa for media inquiries, interviews, and information about our work."
  pubDate={new Date()}
>
  <p>
    Imaging Uganda/Africa is an educational platform connecting medical imaging
    professionals, students, and the wider community through radiology resources
    and case-based learning.
  </p>

  <section>
    <h2>Media inquiries</h2>
    <p>
      For interview requests, background information, or questions about our
      work, please contact us by email. To help us respond, include your
      publication or organization, the topic, and your deadline.
    </p>
    <p>
      <a href="mailto:alexmradiology@gmail.com?subject=Press%20and%20media%20inquiry">
        alexmradiology@gmail.com
      </a>
    </p>
  </section>

  <section>
    <h2>Explore our work</h2>
    <p>
      Learn more about <a href="/about">our story</a>, meet
      <a href="/team">our team</a>, or browse our
      <a href="/articles">educational articles</a> and
      <a href="/cases">radiology cases</a>.
    </p>
  </section>
</Layout>
