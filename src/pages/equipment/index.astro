---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, USD_TO_UGX, DEFAULT_CURRENCY } from '../../consts';
import { formatProductPrice, getWhatsAppLink } from '../../utils/equipment';

const products = await getCollection('equipment');
const siteOrigin = Astro.url.origin;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Medical Equipment | ${SITE_TITLE}`}
      description="Browse medical imaging equipment, ultrasound systems, and radiology devices curated by Imaging Uganda/Africa for clinical practice and training."
    />
    <style>
      main {
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
        padding: 6em 1em 3em 1em;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1.25rem;
        list-style-type: none;
        padding: 0;
      }
      .card {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        background: #fff;
      }
      .card-link {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        color: inherit;
        text-decoration: none;
      }
      .card-link:focus-visible {
        outline: 3px solid #007c89;
        outline-offset: -3px;
      }
      .image-wrapper {
        position: relative;
        width: 100%;
        height: 160px;
        background: #f8fafc;
      }
      .badge-discount {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        z-index: 1;
        border-radius: 4px;
        padding: 0.25rem 0.5rem;
        background: #feefe7;
        color: #f68b1e;
        font-size: 0.75rem;
        font-weight: 700;
      }
      .image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
      .info {
        padding: 1rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
      }
      .title {
        font-size: 1.1rem;
        margin: 0 0 0.5rem 0;
        color: #000;
      }
      .price {
        font-size: 1.1rem;
        font-weight: 700;
        color: #007c89;
        margin-bottom: 0.75rem;
      }
      .original-price {
        margin-right: 0.35rem;
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 400;
      }
      .btn {
        display: block;
        text-align: center;
        background: #007c89;
        color: white;
        padding: 0.45rem;
        text-decoration: none;
        border-radius: 6px;
        font-weight: 600;
        margin: auto 1rem 1rem;
        font-size: 0.9rem;
      }
      .btn:hover {
        background: #005f6a;
      }
      @media (max-width: 600px) {
        .grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 0.75rem;
        }
        .image-wrapper {
          height: 120px;
        }
        .image-wrapper img {
          margin: 0 auto;
        }
        .info {
          padding: 0.75rem;
        }
        .title {
          font-size: 1rem;
        }
        .price {
          font-size: 1rem;
          margin-bottom: 0.5rem;
        }
        .btn {
          margin: auto 0.75rem 0.75rem;
          padding: 0.4rem 0.25rem;
          font-size: 0.75rem;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="section-header">
        <h2>Medical Equipment</h2>
        <p>Browse our curated collection of premium medical devices from trusted manufacturers</p>
      </div>
      <ul class="grid">
        {products.map((product) => {
          const specificProductUrl = `${siteOrigin}/equipment/${product.id}/`;
          const { displayCurrency, displayPrice, discountedPrice } = formatProductPrice(
            product.data.price,
            product.data.currency,
            USD_TO_UGX,
            DEFAULT_CURRENCY,
            product.data.discount,
          );

          return (
            <li class="card">
              <a class="card-link" href={`/equipment/${product.id}/`}>
                <div class="image-wrapper">
                  {product.data.discount > 0 && (
                    <span class="badge-discount">-{product.data.discount}%</span>
                  )}
                  {product.data.images && product.data.images.length > 0 ? (
                    <Image 
                      width={400} 
                      height={300} 
                      src={product.data.images[0]} 
                      alt={product.data.title} 
                    />
                  ) : (
                    <div style="display: flex; align-items: center; justify-content: center; height: 100%; color: #94a3b8;">
                      No Image available
                    </div>
                  )}
                </div>
                <div class="info">
                  <h3 class="title">{product.data.title}</h3>
                  <p class="price">
                    {discountedPrice !== undefined && (
                      <s class="original-price">{displayCurrency} {displayPrice.toLocaleString()}</s>
                    )}
                    {displayCurrency} {(discountedPrice ?? displayPrice).toLocaleString()}
                  </p>
                </div>
              </a>
              <a
                href={getWhatsAppLink(
                  product.data.phoneNumber,
                  product.data.title,
                  discountedPrice ?? displayPrice,
                  displayCurrency,
                  specificProductUrl,
                )}
                class="btn"
                target="_blank"
                rel="noopener noreferrer"
              >
                Inquire on WhatsApp
              </a>
            </li>
          );
        })}
      </ul>
    </main>
    <Footer />
  </body>
</html>
