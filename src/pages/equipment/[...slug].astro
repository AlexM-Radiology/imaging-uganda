---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import { USD_TO_UGX, DEFAULT_CURRENCY } from '../../consts';
import { formatProductPrice, getWhatsAppLink } from '../../utils/equipment';

export async function getStaticPaths() {
  const products = await getCollection('equipment');
  return products.map((product) => ({
    params: { slug: product.id },
    props: product,
  }));
}
type Props = CollectionEntry<'equipment'>;

const product = Astro.props;
const { title, description, price, currency, images = [], phoneNumber, inStock } = product.data;
const relatedProducts = (await getCollection('equipment'))
  .filter((item) => item.id !== product.id)
  .sort((a, b) => {
    const aMatchesCategory = Boolean(product.data.category) && a.data.category === product.data.category;
    const bMatchesCategory = Boolean(product.data.category) && b.data.category === product.data.category;
    return Number(bMatchesCategory) - Number(aMatchesCategory);
  })
  .slice(0, 4);
const { Content } = await render(product);
const currentUrl = Astro.url.href;
const { displayCurrency, displayPrice } = formatProductPrice(
  price,
  currency,
  USD_TO_UGX,
  DEFAULT_CURRENCY,
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      main {
        max-width: 900px;
        margin: 0 auto;
        padding: 6em 1em;
      }
      .product-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
      }
      @media (max-width: 768px) {
        .product-container { grid-template-columns: 1fr; gap: 1.5rem; }
      }
      .carousel-wrapper {
        position: relative;
        width: 100%;
        overflow: hidden;
        border-radius: 12px;
      }
      .carousel {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
      .carousel::-webkit-scrollbar {
        display: none;
      }
      .carousel-item {
        flex: 0 0 100%;
        scroll-snap-align: start;
      }
      .carousel-item img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: contain;
      }
      .buy-btn {
        display: inline-block;
        background: #25D366;
        color: white;
        padding: 0.8rem 2rem;
        text-decoration: none;
        font-weight: 700;
        border-radius: 8px;
        margin: 1rem 0;
        transition: background 0.3s;
      }
      .buy-btn:hover {
        background: #128C7E;
      }
      .related-equipment {
        margin-top: 3rem;
      }
      .related-equipment h2 {
        margin-bottom: 1rem;
      }
      .related-track {
        display: flex;
        gap: 1rem;
        overflow-x: auto;
        padding: 0 0 1rem;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
      }
      .related-card {
        flex: 0 0 200px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        color: inherit;
        text-decoration: none;
        scroll-snap-align: start;
      }
      .related-card img {
        display: block;
        width: 100%;
        height: 160px;
        object-fit: contain;
        background: #f8fafc;
      }
      .related-card-info {
        padding: 0.75rem;
      }
      .related-card h3 {
        margin: 0 0 0.5rem;
        font-size: 1rem;
      }
      .related-card p {
        margin: 0;
        color: #007c89;
        font-weight: 700;
      }
      .related-card:hover h3 {
        color: #007c89;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="product-container">
        <div class="product-image">
          {images && images.length > 0 ? (
            <div class="carousel-wrapper" id="carouselWrapper">
              <div class="carousel" id="imageCarousel">
                {images.map((img: any, index: number) => (
                  <div class="carousel-item">
                    <Image src={img} alt={`${title} - Image ${index + 1}`} width={600} height={600} loading={index === 0 ? "eager" : "lazy"} />
                  </div>
                ))}
              </div>
            </div>
          ) : (
            <p>No images available</p>
          )}
        </div>

        <div class="product-details">
          <h1 style="font-size: 1.8rem;">{title}</h1>
          <p class="price" style="font-size: 1.8rem; font-weight: bold; color: #007c89;">
            {displayCurrency} {displayPrice.toLocaleString()}
          </p>
          {inStock ? (
            <a href={getWhatsAppLink(phoneNumber, title, displayPrice, displayCurrency, currentUrl)} target="_blank" rel="noopener noreferrer" class="buy-btn">
              Inquire on WhatsApp
            </a>
          ) : (
            <p style="color: red; font-weight: bold;">Out of Stock</p>
          )}
        </div>
      </div>
      <hr style="border: 0; border-top: 1px solid #e2e8f0; margin: 2rem 0;" />
      <div class="prose">
        <Content />
      </div>
      {relatedProducts.length > 0 && (
        <section class="related-equipment" aria-labelledby="related-equipment-title">
          <h2 id="related-equipment-title">Related equipment</h2>
          <div class="related-track" tabindex="0" aria-label="Scroll through related equipment">
            {relatedProducts.map((relatedProduct) => {
              const { displayCurrency: relatedCurrency, displayPrice: relatedPrice } = formatProductPrice(
                relatedProduct.data.price,
                relatedProduct.data.currency,
                USD_TO_UGX,
                DEFAULT_CURRENCY,
              );

              return (
                <a class="related-card" href={`/equipment/${relatedProduct.id}/`}>
                  {relatedProduct.data.images.length > 0 ? (
                    <Image
                      src={relatedProduct.data.images[0]}
                      alt={relatedProduct.data.title}
                      width={300}
                      height={240}
                      loading="lazy"
                    />
                  ) : (
                    <div style="height: 160px; display: grid; place-items: center; background: #f8fafc; color: #64748b;">
                      No image available
                    </div>
                  )}
                  <div class="related-card-info">
                    <h3>{relatedProduct.data.title}</h3>
                    <p>{relatedCurrency} {relatedPrice.toLocaleString()}</p>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )}
    </main>
    <Footer />

    <script>
      const carousel = document.getElementById('imageCarousel');
      const wrapper = document.getElementById('carouselWrapper');
      if (carousel && wrapper) {
        let isPaused = false;
        const intervalTime = 3000;
        const autoSwipe = () => {
          if (isPaused) return;
          const itemWidth = carousel.clientWidth;
          const maxScrollLeft = carousel.scrollWidth - itemWidth;
          if (carousel.scrollLeft >= maxScrollLeft - 5) {
            carousel.scrollTo({ left: 0, behavior: 'smooth' });
          } else {
            carousel.scrollBy({ left: itemWidth, behavior: 'smooth' });
          }
        };
        let timer = setInterval(autoSwipe, intervalTime);
        const pauseTimer = () => { isPaused = true; };
        const resumeTimer = () => { isPaused = false; };
        wrapper.addEventListener('mouseenter', pauseTimer);
        wrapper.addEventListener('mouseleave', resumeTimer);
        wrapper.addEventListener('touchstart', pauseTimer, { passive: true });
        wrapper.addEventListener('touchend', resumeTimer);
        carousel.addEventListener('scroll', () => {
          clearInterval(timer);
          timer = setInterval(autoSwipe, intervalTime);
        }, { passive: true });
      }
    </script>
  </body>
</html>
