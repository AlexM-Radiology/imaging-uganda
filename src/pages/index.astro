---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, USD_TO_UGX, DEFAULT_CURRENCY } from '../consts';
import { formatProductPrice } from '../utils/equipment';

const allArticles = await getCollection('articles');
const allCases = await getCollection('cases');

const recentArticles = allArticles
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 7);

const popularCases = allCases
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 7);

const equipmentItems = await getCollection('equipment');

const suggestedArticles = allArticles.map((post) => ({
  title: post.data.title,
  href: `/articles/${post.id}/`,
  category: 'Article',
  image: post.data.heroImage,
}));
const suggestedCases = allCases.map((post) => ({
  title: post.data.title,
  href: `/cases/${post.id}/`,
  category: 'Case study',
  image: post.data.heroImage,
}));
const suggestedItems = [
  ...suggestedArticles.slice(0, 2),
  ...suggestedCases.slice(0, 2),
  ...suggestedArticles.slice(2),
  ...suggestedCases.slice(2),
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${SITE_TITLE} | Ultrasound Education & Radiology Resources`}
      description="Explore expert ultrasound guides, radiology education content, clinical case studies, and medical imaging equipment from Imaging Uganda/Africa."
    />
    <style>
      html, body {
        max-width: 100% !important;
        overflow-x: hidden !important;
        margin: 0;
        padding: 0;
        background-color: #f4f4f5; /* Subtle background matching standard e-commerce mobile views */
      }

      main {
        width: 100% !important;
        max-width: 820px !important;
        margin: 0 auto !important;
        box-sizing: border-box !important;
        padding: calc(var(--header-height) + 1rem) 1em 3em 1em !important;
        background-color: #ffffff;
      }

      h1 {
        font-size: 32px;
        font-weight: 800;
        margin-bottom: 0.5rem;
        color: #000000;
      }
      
      h1 span {
        color: rgb(0, 0, 139);
      }

      .intro-text {
        font-size: 1.05rem;
        line-height: 1.5;
        color: #333333;
        margin-bottom: 2.5rem;
      }

      .section-header {
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        margin-top: 2rem;
        margin-bottom: 1rem;
      }

      .section-header h2 {
        font-size: 1.35rem;
        font-weight: 700;
        color: #000000;
        margin: 0;
      }

      .view-all {
        font-size: 0.9rem;
        font-weight: 700;
        color: #007c89;
        text-decoration: none;
      }

      /* Container block wrapper to isolate tracks and their specific dot lists */
      .carousel-section-wrapper {
        position: relative;
        width: 100%;
      }

      .horizontal-scroll-track {
        display: flex !important;
        flex-direction: row !important; 
        flex-wrap: nowrap !important; 
        gap: 0.85rem !important; 
        width: 100% !important;
        overflow-x: auto !important; 
        overflow-y: hidden !important;
        scroll-snap-type: x proximity !important;
        padding-bottom: 0.5rem;
        margin-bottom: 0.75rem; 
        box-sizing: border-box !important;
        -webkit-overflow-scrolling: touch !important; 
      }

      .horizontal-scroll-track::-webkit-scrollbar {
        height: 6px;
      }
      .horizontal-scroll-track {
        scrollbar-width: thin;
        scrollbar-color: #94a3b8 transparent;
      }

      .horizontal-scroll-track::-webkit-scrollbar-thumb {
        background: #94a3b8;
        border-radius: 999px;
      }

      .scroll-card {
        display: flex !important; 
        flex-direction: column !important;
        flex: 0 0 38% !important; 
        width: 38% !important;
        max-width: 38% !important;
        scroll-snap-align: start !important;
        text-decoration: none !important;
        color: inherit !important;
        box-sizing: border-box !important;
      }

      .card-image-container {
        width: 100% !important;
        aspect-ratio: 1 / 1 !important; 
        border-radius: 12px !important; 
        overflow: hidden !important;
        margin-bottom: 0.4rem;
        background-color: #f0f0f0;
      }

      .card-image-container img {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
      }

      .card-title {
        margin: 0 !important;
        font-size: 0.85rem !important; 
        font-weight: 700 !important;
        line-height: 1.25 !important;
        color: #000000 !important;
        display: -webkit-box;
        -webkit-line-clamp: 2; 
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .scroll-card:hover .card-title {
        color: #007c89 !important;
      }

      .equipment-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr); /* Strict 2-column mobile view */
        gap: 12px 8px;
        width: 100%;
        box-sizing: border-box;
      }

      .equipment-card {
        display: flex;
        flex-direction: column;
        background: #ffffff;
        text-decoration: none;
        color: inherit;
        border-radius: 4px;
        overflow: hidden;
        position: relative;
      }

      .equipment-card[hidden] {
        display: none;
      }

      .equipment-image-container {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        background-color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .equipment-image-container img {
        max-width: 95%;
        max-height: 95%;
        object-fit: contain;
      }

      .badge-discount {
        position: absolute;
        top: 8px;
        right: 8px;
        background-color: #feefe7;
        color: #f68b1e;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 4px;
        z-index: 10;
      }

      .equipment-details {
        padding: 6px 4px;
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .equipment-title {
        margin: 0;
        font-size: 0.85rem;
        font-weight: 400;
        color: #333333;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.6em; /* Keeps layout items balanced vertically */
      }

      .equipment-price {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 700;
        color: #000000;
      }

      .equipment-price s {
        margin-right: 0.35rem;
        color: #64748b;
        font-size: 0.8rem;
        font-weight: 400;
      }

      .suggested-section {
        position: relative;
        margin-top: 2.5rem;
        padding: 1.25rem;
        overflow: hidden;
        border: 1px solid #dbeafe;
        border-radius: 20px;
        background:
          radial-gradient(ellipse at top right, rgba(45, 212, 191, 0.2), transparent 48%),
          linear-gradient(135deg, #eff6ff 0%, #f8fafc 55%, #ecfeff 100%);
      }

      .suggested-section::before {
        position: absolute;
        top: -48px;
        right: -36px;
        width: 150px;
        height: 150px;
        border: 1px solid rgba(14, 116, 144, 0.12);
        border-radius: 50%;
        content: '';
        pointer-events: none;
      }

      .suggested-heading {
        position: relative;
        margin-bottom: 1rem;
      }

      .suggested-eyebrow {
        margin: 0 0 0.35rem;
        color: #0e7490;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      .suggested-title {
        margin: 0;
        color: #102a43;
        font-size: 1.45rem;
        font-weight: 800;
        letter-spacing: -0.03em;
      }

      .suggested-description {
        max-width: 32rem;
        margin: 0.4rem 0 0;
        color: #486581;
        font-size: 0.9rem;
        line-height: 1.5;
      }

      .suggested-grid {
        position: relative;
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.65rem;
      }

      .suggested-card {
        display: flex;
        min-width: 0;
        align-items: center;
        gap: 0.8rem;
        padding: 0.7rem;
        border: 1px solid rgba(203, 213, 225, 0.8);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.88);
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
        color: inherit;
        text-decoration: none;
        transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
      }

      .suggested-card[hidden] {
        display: none;
      }

      .suggested-card:hover {
        transform: translateY(-2px);
        border-color: #67e8f9;
        box-shadow: 0 10px 24px rgba(15, 118, 110, 0.12);
      }

      .suggested-thumbnail {
        display: grid;
        width: 64px;
        height: 64px;
        flex: 0 0 64px;
        place-items: center;
        overflow: hidden;
        border-radius: 10px;
        background: linear-gradient(135deg, #cffafe, #dbeafe);
        color: #0e7490;
      }

      .suggested-thumbnail img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .suggested-thumbnail svg {
        width: 28px;
        height: 28px;
      }

      .suggested-card-content {
        min-width: 0;
      }

      .suggested-category {
        display: block;
        margin-bottom: 0.25rem;
        color: #0e7490;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .suggested-card-title {
        display: -webkit-box;
        margin: 0;
        overflow: hidden;
        color: #102a43;
        font-size: 0.88rem;
        font-weight: 700;
        line-height: 1.35;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
      }

      .suggested-arrow {
        margin-left: auto;
        padding-left: 0.25rem;
        color: #0e7490;
        font-size: 1.1rem;
        font-weight: 700;
      }

      @media (min-width: 550px) {
        .scroll-card {
          flex: 0 0 28% !important;
          width: 28% !important;
          max-width: 28% !important;
        }
        .equipment-grid {
          grid-template-columns: repeat(3, 1fr); /* Scales clean to 3 items on wide devices */
          gap: 16px;
        }
        .suggested-section {
          padding: 1.5rem;
        }
        .suggested-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 0.75rem;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>Imaging Uganda<span>/Africa</span></h1>
      <p class="intro-text">
        We bridge the gap between radiology professionals and patients by providing high-quality educational content on medical imaging, diagnostic procedures, and radiology case studies. Whether you're a healthcare provider, student, or patient, our resources help you understand imaging techniques, conditions, and the latest advancements in radiology.
      </p>

      <section class="carousel-section-wrapper">
        <div class="section-header">
          <h2>Recent Articles</h2>
          <a href="/articles/" class="view-all">View all</a>
        </div>
        
        <div class="horizontal-scroll-track class-scroll-track">
          {
            recentArticles.map((post) => (
              <a href={`/articles/${post.id}/`} class="scroll-card">
                <div class="card-image-container">
                  {post.data.heroImage ? (
                    <Image 
                      width={200} 
                      height={200} 
                      src={post.data.heroImage} 
                      alt="" 
                    />
                  ) : (
                    <div style="width:100%; height:100%; background:#e0e0e0;" />
                  )}
                </div>
                <h3 class="card-title">{post.data.title}</h3>
              </a>
            ))
          }
        </div>

      </section>

      <section class="carousel-section-wrapper">
        <div class="section-header">
          <h2>Popular Cases</h2>
          <a href="/cases/" class="view-all">View all</a>
        </div>
        
        <div class="horizontal-scroll-track class-scroll-track">
          {
            popularCases.map((post) => (
              <a href={`/cases/${post.id}/`} class="scroll-card">
                <div class="card-image-container">
                  {post.data.heroImage ? (
                    <Image 
                      width={200} 
                      height={200} 
                      src={post.data.heroImage} 
                      alt="" 
                    />
                  ) : (
                    <div style="width:100%; height:100%; background:#e0e0e0;" />
                  )}
                </div>
                <h3 class="card-title">{post.data.title}</h3>
              </a>
            ))
          }
        </div>

      </section>

      <section class="equipment-section-container">
        <div class="section-header">
          <h2>Medical Equipment</h2>
          <a href="/equipment/" class="view-all">View all</a>
        </div>

        <div class="equipment-grid">
          {
            equipmentItems.map((product, index) => {
              const discount = product.data.discount;
              const { displayCurrency, displayPrice, discountedPrice } = formatProductPrice(
                product.data.price,
                product.data.currency,
                USD_TO_UGX,
                DEFAULT_CURRENCY,
                discount,
              );

              return (
                <a href={`/equipment/${product.id}/`} class="equipment-card" hidden={index >= 6}>
                  <div class="equipment-image-container">
                    {discount > 0 && <span class="badge-discount">-{discount}%</span>}
                    {product.data.images && product.data.images.length > 0 ? (
                      <Image 
                        width={250} 
                        height={250} 
                        src={product.data.images[0]} 
                        alt={product.data.title} 
                      />
                    ) : (
                      <div style="display:flex; align-items:center; justify-content:center; height:100%; width:100%; color:#94a3b8; font-size:0.8rem; background:#f8fafc;">
                        No Image
                      </div>
                    )}
                  </div>
                  <div class="equipment-details">
                    <h3 class="equipment-title">{product.data.title}</h3>
                    <p class="equipment-price">
                      {discountedPrice !== undefined && (
                        <s>{displayCurrency} {displayPrice.toLocaleString()}</s>
                      )}
                      {displayCurrency} {(discountedPrice ?? displayPrice).toLocaleString()}
                    </p>
                  </div>
                </a>
              );
            })
          }
        </div>
      </section>

      <section class="suggested-section" aria-labelledby="suggested-title">
        <div class="suggested-heading">
          <p class="suggested-eyebrow">Picked for curious minds</p>
          <h2 class="suggested-title" id="suggested-title">Suggested for you</h2>
          <p class="suggested-description">
            A few useful reads and real-world cases to keep your learning moving.
          </p>
        </div>

        <div class="suggested-grid">
          {
            suggestedItems.map((item, index) => (
              <a
                href={item.href}
                class="suggested-card"
                data-suggested-card
                data-suggested-category={item.category}
                hidden={index >= 4}
              >
                <div class="suggested-thumbnail" aria-hidden="true">
                  {item.image ? (
                    <Image width={128} height={128} src={item.image} alt="" loading="lazy" />
                  ) : (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path
                        d="M5 4.75A1.75 1.75 0 0 1 6.75 3H20v15H7a2 2 0 0 0-2 2V4.75ZM5 20a2 2 0 0 1 2-2h13"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                      <path d="M9 7h7M9 10h7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                    </svg>
                  )}
                </div>
                <div class="suggested-card-content">
                  <span class="suggested-category">{item.category}</span>
                  <h3 class="suggested-card-title">{item.title}</h3>
                </div>
                <span class="suggested-arrow" aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>
      </section>
    </main>
    <Footer />
    <script>
      const suggestedGrid = document.querySelector<HTMLDivElement>('.suggested-grid');

      if (suggestedGrid) {
        const suggestedCards = Array.from(
          suggestedGrid.querySelectorAll<HTMLAnchorElement>('[data-suggested-card]'),
        );
        const reshuffleSuggestions = () => {
          const halfHourWindow = Math.floor(Date.now() / (30 * 60 * 1000));
          let seed = halfHourWindow >>> 0;
          const nextRandom = () => {
            seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
            return seed / 4294967296;
          };
          const shuffle = (cards: HTMLAnchorElement[]) => {
            for (let index = cards.length - 1; index > 0; index -= 1) {
              const swapIndex = Math.floor(nextRandom() * (index + 1));
              [cards[index], cards[swapIndex]] = [cards[swapIndex], cards[index]];
            }
            return cards;
          };

          const articles = shuffle(
            suggestedCards.filter((card) => card.dataset.suggestedCategory === 'Article'),
          );
          const cases = shuffle(
            suggestedCards.filter((card) => card.dataset.suggestedCategory === 'Case study'),
          );
          const selectedCards = shuffle([...articles.slice(0, 2), ...cases.slice(0, 2)]);

          suggestedCards.forEach((card) => {
            card.hidden = true;
          });
          selectedCards.forEach((card) => {
            card.hidden = false;
            suggestedGrid.append(card);
          });
        };
        const scheduleNextReshuffle = () => {
          const millisecondsPerWindow = 30 * 60 * 1000;
          const delay = millisecondsPerWindow - (Date.now() % millisecondsPerWindow);
          window.setTimeout(() => {
            reshuffleSuggestions();
            scheduleNextReshuffle();
          }, delay);
        };

        reshuffleSuggestions();
        scheduleNextReshuffle();
      }

      const equipmentGrid = document.querySelector<HTMLDivElement>('.equipment-grid');

      if (equipmentGrid) {
        const equipmentCards = Array.from(
          equipmentGrid.querySelectorAll<HTMLAnchorElement>('.equipment-card'),
        );
        const dateSeed = new Date().toISOString().slice(0, 10);
        let seed = 2166136261;

        for (const character of dateSeed) {
          seed = Math.imul(seed ^ character.charCodeAt(0), 16777619);
        }

        seed >>>= 0;
        const nextRandom = () => {
          seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
          return seed / 4294967296;
        };

        for (let index = equipmentCards.length - 1; index > 0; index -= 1) {
          const swapIndex = Math.floor(nextRandom() * (index + 1));
          [equipmentCards[index], equipmentCards[swapIndex]] = [
            equipmentCards[swapIndex],
            equipmentCards[index],
          ];
        }

        equipmentCards.forEach((card, index) => {
          card.hidden = index >= 6;
          equipmentGrid.append(card);
        });
      }
    </script>
  </body>
</html>